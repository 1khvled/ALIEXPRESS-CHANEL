# ==========================================
# Telegram Collector (MTProto / Telethon)
# ==========================================
# Obtain from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=deals_collector

# ==========================================
# Telegram Publisher (Bot API)
# ==========================================
# Obtain from @BotFather
TELEGRAM_BOT_TOKEN=
# Target Telegram channel username or ID (e.g. @MyDealsChannel or -1001234567890)
TARGET_CHANNEL_ID=

# ==========================================
# Database Configuration
# ==========================================
# For SQLite (default zero-config local run):
DATABASE_URL=sqlite+aiosqlite:///deals.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/deals

# ==========================================
# Application & Publishing Settings
# ==========================================
APP_ENV=development
LOG_LEVEL=INFO
# Modes: auto | approval | dry_run
PUBLISH_MODE=approval
POLL_INTERVAL_SECONDS=180
# Base URL for tracking redirect links: https://deals.example.com or http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000

# ==========================================
# Rate Limiting & Cooldown Protection
# ==========================================
MAX_POSTS_PER_HOUR=6
MAX_POSTS_PER_DAY=40
COOLDOWN_MINUTES=10
MIN_QUALITY_SCORE=60
AUTO_PUBLISH_QUALITY_SCORE=85
DUPLICATE_COOLDOWN_HOURS=24
EUR_USD_RATE=0.92

# ==========================================
# AliExpress Affiliate Settings
# ==========================================
# Provider options: direct | portals | mock
ALIEXPRESS_AFFILIATE_PROVIDER=direct
ALIEXPRESS_AFFILIATE_TRACKING_ID=
ALIEXPRESS_AFFILIATE_APP_KEY=
ALIEXPRESS_AFFILIATE_APP_SECRET=
# Custom affiliate redirect prefix (if using a third-party affiliate network)
ALIEXPRESS_CUSTOM_AFFILIATE_PREFIX=

# ==========================================
# AI Provider Settings
# ==========================================
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
